{
  "name": "rsc-state-sync",
  "version": "0.1.3",
  "description": "State rehydration bridge for React Server Components: keep serializable client UI state alive across RSC navigation.",
  "keywords": [
    "react",
    "rsc",
    "react-server-components",
    "nextjs",
    "app-router",
    "navigation",
    "state",
    "suspense",
    "view-transitions"
  ],
  "license": "MIT",
  "homepage": "https://github.com/modeusweb/rsc-state-sync#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modeusweb/rsc-state-sync.git"
  },
  "bugs": {
    "url": "https://github.com/modeusweb/rsc-state-sync/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18.18"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/core/index.js",
  "module": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "import": "./dist/next/index.js",
      "require": "./dist/next/index.js",
      "default": "./dist/next/index.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "next": ">=13.4.0",
    "react": ">=18.2.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup && node scripts/postbuild.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tests benchmarks scripts",
    "bench": "node benchmarks/run.mjs",
    "size": "node benchmarks/size.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run size"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.4",
    "jsdom": "^27.4.0",
    "next": "^16.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.4",
    "vitest": "^3.2.4"
  }
}
